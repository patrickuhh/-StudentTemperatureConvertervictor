pipeline {
    agent any

    stages {
        stage('Build and Test') {
            steps {
                dir('StudentTemperatureConverter') {
                    sh 'mvn -B clean test'
                }
            }
        }

        stage('Publish Test Results') {
            steps {
                junit 'StudentTemperatureConverter/target/surefire-reports/*.xml'
            }
        }
    }

    post {
        success {
            echo 'Build and tests completed successfully!'
        }
        failure {
            echo 'Build or tests failed. Review the console output.'
        }
    }
}
